{
  "name": "sovemu-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "SovEmu web client: Vite + React + TanStack Router + Tailwind, served as static files by the SovEmu Rust server",
  "scripts": {
    "dev": "vite",
    "build": "tsc && gql.tada check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "schema": "gql.tada generate-output",
    "schema:check": "gql.tada generate-output && git diff --exit-code -- src/graphql-env.d.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@0no-co/graphql.web": "^1.3.4",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "gql.tada": "^1.11.5",
    "lucide-react": "^1.73.0",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
