---
// The player: a splash while the session starts (Continue / Start over when there is an auto
// save), then the stream full-screen, with an in-game menu on Escape, the gamepad's Home button,
// or Select+Start. The menu saves and loads states into slots with screenshots.
import Base from "../../layouts/Base.astro";
---

<Base title="Playing">
  <main class="fixed inset-0 grid place-items-center bg-black">
    <div data-screen class="relative h-full max-h-dvh w-auto max-w-full" style="aspect-ratio: 4 / 3">
      <video data-video autoplay playsinline class="pixelated absolute inset-0 h-full w-full object-fill"></video>
      <canvas data-canvas class="absolute inset-0 h-full w-full"></canvas>
    </div>

    <section data-splash class="absolute inset-0 grid place-items-center bg-surface">
      <div class="grid justify-items-center gap-3 text-center">
        <span data-badge class="rounded-lg px-3 py-1 text-sm font-black"></span>
        <h1 data-title class="max-w-3xl text-4xl font-black md:text-5xl"></h1>
        <p data-status class="text-slate-400">Starting…</p>
      </div>
      <!-- The loading bar: what the start is doing, how far it has got, and for how long. -->
      <div data-progress class="absolute inset-x-0 bottom-10 mx-auto grid w-[28rem] max-w-[86vw] gap-2" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="flex items-baseline justify-between gap-4 text-sm">
          <span data-progress-label class="font-semibold text-slate-200">Starting</span>
          <span data-progress-detail class="text-xs tabular-nums text-slate-500"></span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-white/10">
          <div data-progress-bar class="h-full w-0 rounded-full transition-[width] duration-300 ease-out"></div>
        </div>
      </div>
    </section>

    <!-- The menu stack: splash choices, in-game menu, slot pickers. -->
    <section data-menu class="absolute inset-0 hidden place-items-center">
      <div class="w-[26rem] max-w-[92vw] rounded-2xl border border-white/10 bg-panel/95 p-3 shadow-2xl backdrop-blur">
        <p data-menu-title class="truncate px-3 pb-2 pt-1 text-sm text-slate-400"></p>
        <ul data-items class="grid max-h-[70vh] gap-1 overflow-y-auto"></ul>
      </div>
    </section>

    <dl data-stats class="pointer-events-none absolute left-4 top-4 hidden grid-cols-[auto_auto] gap-x-4 gap-y-0.5 rounded-lg bg-black/70 px-3 py-2 font-mono text-xs"></dl>
    <p data-toast class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 rounded-full bg-black/80 px-4 py-2 text-sm"></p>
  </main>
</Base>

<script>
  import { AUTO_SLOT, api, screenshotUrl, type SaveSlot, type SessionInfo } from "../../lib/api";
  import { DEFAULT_BINDINGS, InputState, bind, captureNextInput, describeBinding } from "../../lib/input";
  import { FILTERS, VideoFilter, type FilterMode } from "../../lib/filter";
  import type { ButtonName } from "../../lib/protocol";
  import { MenuStack, type Menu, type MenuItem } from "../../lib/menu";
  import { ForwardOnly, describeStart, newStartId, type StartStatus } from "../../lib/launch";
  import { listenNav } from "../../lib/nav";
  import { Session } from "../../lib/session";
  import { StatsSampler } from "../../lib/stats";

  const $ = <T extends HTMLElement>(name: string) => document.querySelector<T>(`[data-${name}]`)!;
  const video = $<HTMLVideoElement>("video");
  const gameId = Number(new URLSearchParams(location.search).get("game"));
  const SLOTS = [1, 2, 3, 4];

  let toastTimer = 0;
  const toast = (text: string) => {
    const el = $("toast");
    el.textContent = text;
    el.classList.remove("hidden");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => el.classList.add("hidden"), 2500);
  };
  const ago = (unix: number) => {
    const s = Math.max(0, Math.round(Date.now() / 1000 - unix));
    if (s < 60) return "just now";
    if (s < 3600) return `${Math.round(s / 60)} min ago`;
    if (s < 86400) return `${Math.round(s / 3600)} h ago`;
    return new Date(unix * 1000).toLocaleDateString();
  };

  const [game, systems, initialSlots, config] = await Promise.all([
    api.game(gameId),
    api.systems(),
    api.states(gameId),
    api.config(),
  ]);
  const system = systems.find((s) => s.id === game.system);
  const color = system?.color ?? "#4169e1";
  document.title = `${game.title} · SovEmu`;
  $("title").textContent = game.title;
  $("badge").textContent = system?.short ?? game.system;
  $("badge").style.background = color;
  $("splash").style.background = `radial-gradient(ellipse at 50% 40%, color-mix(in srgb, ${color} 40%, transparent), #0b0d12 70%)`;

  // --- The session ----------------------------------------------------------------------------
  let info: SessionInfo | null = null;
  // Start at once (the splash's choices show meanwhile), and follow the start on the bar.
  const startId = newStartId();
  const bar = new ForwardOnly();
  $("progress-bar").style.background = color;
  const showProgress = (p: StartStatus) => {
    const view = describeStart(p);
    const percent = Math.round(bar.next(view.fraction) * 100);
    $("progress-label").textContent = view.label;
    $("progress-detail").textContent = view.detail;
    $("progress-bar").style.width = `${percent}%`;
    $("progress").setAttribute("aria-valuenow", String(percent));
  };
  let polling = true;
  const poll = async () => {
    while (polling) {
      const p = await api.startProgress(startId).catch(() => null);
      if (!polling) break;
      if (p) showProgress(p);
      await new Promise((r) => setTimeout(r, 250));
    }
  };
  void poll();
  const starting = api.startSession(gameId, startId).then((s) => {
    polling = false;
    showProgress({ phase: "ready", elapsed_ms: 0, phase_ms: 0 });
    setTimeout(() => $("progress").classList.add("hidden"), 600);
    info = s;
    $("screen").style.aspectRatio = ["gb", "gbc", "gba", "gamegear"].includes(game.system) ? `${s.width} / ${s.height}` : "4 / 3";
    $("status").textContent = `${s.core} · ${s.width}×${s.height} @ ${s.fps.toFixed(2)} fps`;
    return s;
  });
  starting.catch((e) => {
    polling = false;
    showProgress({ phase: "failed", elapsed_ms: 0, phase_ms: 0, error: (e as Error).message });
    $("progress-bar").style.width = "0%";
  });

  const input = new InputState();
  input.analogSticks = !!system?.needs_gpu;

  // Display filter: WebGL over the video when available, else the video itself.
  const FILTER_KEY = "sovemu.filter";
  const filter = new VideoFilter(video, $<HTMLCanvasElement>("canvas"));
  let filterMode = (localStorage.getItem(FILTER_KEY) as FilterMode) || "sharp";
  if (filter.supported) {
    video.classList.add("opacity-0");
    filter.setMode(filterMode);
  } else {
    $("canvas").classList.add("hidden");
  }
  let capturing = false;
  let session: Session | null = null;
  const sampler = new StatsSampler();
  let statsOn = false;

  async function begin(slot: number | null) {
    let s: SessionInfo;
    try {
      s = await starting;
    } catch (e) {
      $("status").textContent = `Could not start: ${(e as Error).message}`;
      return;
    }
    if (slot !== null) await api.loadState(s.id, slot).catch((e) => toast(`Could not load: ${e.message}`));
    menus.close();
    $("splash").classList.add("hidden");
    session = new Session(`/api/sessions/${s.id}/offer`, video, input, {
      onState: (state) => {
        if (state === "connected") {
          filter.start();
          toast("Menu: Escape or Select+Start · Hold Tab / Select+R to fast-forward, Backspace / Select+L to rewind");
        }
        if (state === "failed" || state === "disconnected") toast(`Connection ${state}`);
      },
    }, { iceServers: config.ice_servers });
    await session.connect();
  }

  async function quit() {
    session?.close();
    if (info) {
      $("status").textContent = "Saving…";
      await api.stopSession(info.id).catch(() => {});
    }
    location.href = `/system/?id=${encodeURIComponent(game.system)}`;
  }

  // --- Menus ----------------------------------------------------------------------------------
  const itemsEl = $<HTMLUListElement>("items");
  const menus = new MenuStack(render);

  function render() {
    const top = menus.current;
    $("menu").classList.toggle("hidden", !top);
    $("menu").classList.toggle("grid", !!top);
    $("menu").classList.toggle("bg-black/70", !!session);
    if (session) session.suspended = menus.open;
    if (!top) return;
    $("menu-title").textContent = top.menu.title;
    itemsEl.replaceChildren(
      ...top.menu.items.map((item, i) => {
        const li = document.createElement("li");
        li.className = "flex cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5";
        if (item.disabled) li.classList.add("opacity-40", "cursor-default");
        if (i === top.index) li.style.background = color;
        if (item.image !== undefined) {
          const box = document.createElement("div");
          box.className = "pixelated grid h-12 w-16 shrink-0 place-items-center overflow-hidden rounded bg-black/50 text-xs text-slate-500";
          if (item.image) {
            const img = document.createElement("img");
            img.src = item.image;
            img.className = "pixelated h-full w-full object-cover";
            box.append(img);
          } else box.textContent = "—";
          li.append(box);
        }
        const text = document.createElement("div");
        text.className = "min-w-0";
        text.innerHTML = `<div class="truncate text-lg"></div><div class="truncate text-xs text-slate-300"></div>`;
        text.children[0].textContent = item.label;
        text.children[1].textContent = item.detail ?? "";
        li.append(text);
        li.addEventListener("click", () => menus.activate(i));
        return li;
      }),
    );
  }

  function slotItems(slots: SaveSlot[], numbers: number[], onPick: (slot: number) => void, emptyEnabled: boolean): MenuItem[] {
    return numbers.map((n) => {
      const s = slots.find((x) => x.slot === n);
      return {
        label: n === AUTO_SLOT ? "Auto save" : `Slot ${n}`,
        detail: s ? ago(s.saved_at) : "Empty",
        image: s?.screenshot ? screenshotUrl(gameId, s) : "",
        disabled: !s && !emptyEnabled,
        run: () => onPick(n),
      };
    });
  }

  async function saveMenu() {
    const slots = await api.states(gameId);
    menus.push({
      title: "Save state",
      items: slotItems(slots, SLOTS, async (slot) => {
        if (!info) return;
        try {
          await api.saveState(info.id, slot);
          menus.close();
          toast(`Saved to slot ${slot}`);
        } catch (e) {
          toast(`Save failed: ${(e as Error).message}`);
        }
      }, true),
    });
  }

  async function loadMenu() {
    const slots = await api.states(gameId);
    menus.push({
      title: "Load state",
      items: slotItems(slots, [AUTO_SLOT, ...SLOTS], async (slot) => {
        if (!info) return;
        try {
          await api.loadState(info.id, slot);
          menus.close();
          toast(slot === AUTO_SLOT ? "Loaded the auto save" : `Loaded slot ${slot}`);
        } catch (e) {
          toast(`Load failed: ${(e as Error).message}`);
        }
      }, false),
    });
  }

  function filterMenu() {
    menus.push({
      title: "Display filter",
      items: FILTERS.map(({ mode, label }) => ({
        label,
        detail: mode === filterMode ? "Selected" : "",
        run: () => {
          filterMode = mode;
          localStorage.setItem(FILTER_KEY, mode);
          filter.setMode(mode);
          menus.close();
          toast(label);
        },
      })),
    });
  }

  const REMAPPABLE: ButtonName[] = ["UP", "DOWN", "LEFT", "RIGHT", "A", "B", "X", "Y", "L", "R", "L2", "R2", "START", "SELECT"];
  const controlsMenu = (): Menu => ({
    title: "Controls: choose a button, then press a key or pad button",
    items: [
      ...REMAPPABLE.map((button) => ({
        label: button,
        detail: describeBinding(input.bindings, button),
        run: async () => {
          capturing = true;
          toast(`Press a key or button for ${button} (Escape cancels)`);
          const pressed = await captureNextInput();
          // Let the press that bound the button finish before menus react again.
          setTimeout(() => (capturing = false), 250);
          if (pressed) input.setBindings(bind(input.bindings, pressed, button));
          menus.replace(controlsMenu());
        },
      })),
      {
        label: "Reset to defaults",
        run: () => {
          input.setBindings(structuredClone(DEFAULT_BINDINGS));
          menus.replace(controlsMenu());
          toast("Controls reset");
        },
      },
    ],
  });

  async function cheatsMenu(replace = false) {
    const cheats = await api.cheats(gameId);
    const menu: Menu = {
      title: "Cheats: choose one to turn it on or off",
      items: [
        ...cheats.map((c) => ({
          label: `${c.enabled ? "●" : "○"} ${c.description || c.code}`,
          detail: c.description ? c.code : "",
          run: async () => {
            await api.setCheat(gameId, c.id, !c.enabled);
            await cheatsMenu(true);
          },
        })),
        {
          label: "Add a cheat…",
          detail: "Game Genie, Pro Action Replay or the core's own format",
          run: async () => {
            const code = prompt("Cheat code")?.trim();
            if (!code) return;
            const description = prompt("What does it do? (optional)")?.trim() ?? "";
            try {
              await api.addCheat(gameId, code, description);
              toast("Cheat added");
            } catch (e) {
              toast(`Could not add: ${(e as Error).message}`);
            }
            await cheatsMenu(true);
          },
        },
      ],
    };
    if (replace) menus.replace(menu);
    else menus.push(menu);
  }

  const gameMenu = (): Menu => ({
    title: game.title,
    items: [
      { label: "Resume", run: () => menus.close() },
      { label: "Save state", run: saveMenu },
      { label: "Load state", run: loadMenu },
      { label: "Cheats", run: () => cheatsMenu() },
      { label: "Controls", run: () => menus.push(controlsMenu()) },
      { label: "Display filter", detail: FILTERS.find((f) => f.mode === filterMode)?.label, run: filterMenu },
      {
        label: "Reset",
        run: async () => {
          if (info) await api.resetSession(info.id);
          menus.close();
          toast("Reset");
        },
      },
      {
        label: statsOn ? "Hide stats" : "Show stats",
        run: () => {
          statsOn = !statsOn;
          $("stats").classList.toggle("hidden", !statsOn);
          $("stats").classList.toggle("grid", statsOn);
          menus.close();
        },
      },
      { label: "Quit game", detail: "Saves your progress", run: quit },
    ],
  });

  // The splash: continue from the auto save when there is one.
  const auto = initialSlots.find((s) => s.slot === AUTO_SLOT);
  menus.push({
    title: auto ? "Welcome back" : "Ready",
    onBack: () => void quit(),
    items: auto
      ? [
          { label: "Continue", detail: `Auto save, ${ago(auto.saved_at)}`, image: auto.screenshot ? screenshotUrl(gameId, auto) : "", run: () => begin(AUTO_SLOT) },
          { label: "Start over", run: () => begin(null) },
          { label: "Back", run: quit },
        ]
      : [
          { label: "Start", run: () => begin(null) },
          { label: "Back", run: quit },
        ],
  });
  $("menu").classList.remove("bg-black/70");

  // Menu navigation. While playing with no menu open, game keys must not drive menus.
  listenNav((action) => {
    if (capturing || (session && !menus.open)) return;
    menus.handle(action);
  });

  // Opening the menu while playing: Escape, gamepad Home, or Select+Start together.
  addEventListener("keydown", (e) => {
    if (session && !menus.open && e.code === "Escape") {
      e.preventDefault();
      menus.push(gameMenu());
    }
  });
  let comboHeld = false;
  const watchPads = () => {
    if (session) {
      const combo = [...(navigator.getGamepads?.() ?? [])].some(
        (p) => p && (p.buttons[16]?.pressed || (p.buttons[8]?.pressed && p.buttons[9]?.pressed)),
      );
      if (combo && !comboHeld && !menus.open) menus.push(gameMenu());
      comboHeld = combo;
    }
    requestAnimationFrame(watchPads);
  };
  requestAnimationFrame(watchPads);

  setInterval(async () => {
    if (!session || !statsOn) return;
    const rows = await sampler.sample(session);
    $("stats").replaceChildren(
      ...rows.flatMap(({ label, value }) => {
        const dt = document.createElement("dt");
        dt.className = "text-slate-400";
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.className = "text-right tabular-nums";
        dd.textContent = value;
        return [dt, dd];
      }),
    );
  }, 1000);

  // Leaving the page ends the session (which writes the auto save) rather than waiting for the
  // idle timeout.
  addEventListener("pagehide", () => {
    if (info) navigator.sendBeacon?.(`/api/sessions/${info.id}/stop`);
  });
</script>
