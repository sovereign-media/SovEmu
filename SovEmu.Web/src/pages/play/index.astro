---
// The player: a splash while the session starts, then the stream full-screen, with an in-game
// menu on Escape, the gamepad's Home button, or Select+Start.
import Base from "../../layouts/Base.astro";
---

<Base title="Playing">
  <main class="fixed inset-0 grid place-items-center bg-black">
    <video data-video autoplay playsinline class="pixelated h-full max-h-dvh w-auto max-w-full object-contain" style="aspect-ratio: 4 / 3"></video>

    <!-- Splash: shown until the player presses a button (which also unlocks audio). -->
    <section data-splash class="absolute inset-0 grid place-items-center bg-surface">
      <div class="grid justify-items-center gap-4 text-center">
        <span data-badge class="rounded-lg px-3 py-1 text-sm font-black"></span>
        <h1 data-title class="max-w-3xl text-4xl font-black md:text-5xl"></h1>
        <p data-status class="text-slate-400">Starting…</p>
        <p data-prompt class="invisible mt-6 animate-pulse text-lg">Press <b>A</b> / <b>Enter</b> to start</p>
      </div>
    </section>

    <!-- In-game menu. -->
    <section data-menu class="absolute inset-0 hidden place-items-center bg-black/70 backdrop-blur-sm">
      <div class="w-80 rounded-2xl border border-white/10 bg-panel/95 p-3 shadow-2xl">
        <p data-menu-title class="truncate px-3 pb-2 pt-1 text-sm text-slate-400"></p>
        <ul data-items class="grid gap-1"></ul>
      </div>
    </section>

    <dl data-stats class="pointer-events-none absolute left-4 top-4 hidden grid-cols-[auto_auto] gap-x-4 gap-y-0.5 rounded-lg bg-black/70 px-3 py-2 font-mono text-xs"></dl>
    <p data-toast class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 rounded-full bg-black/80 px-4 py-2 text-sm"></p>
  </main>
</Base>

<script>
  import { api, type SessionInfo } from "../../lib/api";
  import { InputState } from "../../lib/input";
  import { listenNav } from "../../lib/nav";
  import { Session } from "../../lib/session";
  import { StatsSampler } from "../../lib/stats";

  const $ = <T extends HTMLElement>(name: string) => document.querySelector<T>(`[data-${name}]`)!;
  const video = $<HTMLVideoElement>("video");
  const gameId = Number(new URLSearchParams(location.search).get("game"));

  const toast = (text: string) => {
    const el = $("toast");
    el.textContent = text;
    el.classList.remove("hidden");
    clearTimeout((el as unknown as { timer?: number }).timer);
    (el as unknown as { timer?: number }).timer = window.setTimeout(() => el.classList.add("hidden"), 2500);
  };

  const [game, systems] = await Promise.all([api.game(gameId), api.systems()]);
  const system = systems.find((s) => s.id === game.system);
  const color = system?.color ?? "#4169e1";
  document.title = `${game.title} · SovEmu`;
  $("title").textContent = game.title;
  $("menu-title").textContent = game.title;
  $("badge").textContent = system?.short ?? game.system;
  $("badge").style.background = color;
  $("splash").style.background = `radial-gradient(ellipse at 50% 40%, color-mix(in srgb, ${color} 40%, transparent), #0b0d12 70%)`;

  // Start the session while the splash is up; the worker loads the core and game meanwhile.
  let info: SessionInfo | null = null;
  const starting = api.startSession(gameId).then(
    (s) => {
      info = s;
      video.style.aspectRatio = aspectFor(game.system, s.width, s.height);
      $("status").textContent = `${s.core} · ${s.width}×${s.height} @ ${s.fps.toFixed(2)} fps`;
      $("prompt").classList.remove("invisible");
      return s;
    },
    (e: Error) => {
      $("status").textContent = `Could not start: ${e.message}`;
      $("prompt").textContent = "Press B / Escape to go back";
      $("prompt").classList.remove("invisible");
      throw e;
    },
  );

  /** The display aspect: 4:3 for TV consoles, the panel's own shape for handhelds. */
  function aspectFor(systemId: string, w: number, h: number): string {
    return ["gb", "gbc", "gba", "gamegear"].includes(systemId) ? `${w} / ${h}` : "4 / 3";
  }

  const input = new InputState();
  let session: Session | null = null;
  const sampler = new StatsSampler();
  let statsOn = false;

  async function begin() {
    const s = await starting.catch(() => null);
    if (!s) return quit();
    $("splash").classList.add("hidden");
    nav.paused = true;
    session = new Session(`/api/sessions/${s.id}/offer`, video, input, {
      onState: (state) => {
        if (state === "connected") toast(`${game.title}: Escape or Select+Start for the menu`);
        if (state === "failed" || state === "disconnected") toast(`Connection ${state}`);
      },
    });
    await session.connect();
  }

  async function quit() {
    session?.close();
    if (info) await api.stopSession(info.id).catch(() => {});
    location.href = `/system/?id=${encodeURIComponent(game.system)}`;
  }

  // Menu.
  type Item = { label: string; run: () => void | Promise<void> };
  const items: Item[] = [
    { label: "Resume", run: () => closeMenu() },
    {
      label: "Reset",
      run: async () => {
        if (info) await api.resetSession(info.id);
        closeMenu();
        toast("Reset");
      },
    },
    {
      label: "Show stats",
      run: () => {
        statsOn = !statsOn;
        $("stats").classList.toggle("hidden", !statsOn);
        $("stats").classList.toggle("grid", statsOn);
        closeMenu();
      },
    },
    { label: "Quit game", run: () => quit() },
  ];
  let menuOpen = false;
  let menuIndex = 0;
  const itemsEl = $<HTMLUListElement>("items");

  function renderMenu() {
    itemsEl.replaceChildren(
      ...items.map((item, i) => {
        const li = document.createElement("li");
        li.className = "cursor-pointer rounded-lg px-4 py-3 text-lg";
        li.textContent = item.label === "Show stats" && statsOn ? "Hide stats" : item.label;
        if (i === menuIndex) li.style.background = color;
        li.addEventListener("click", () => item.run());
        return li;
      }),
    );
  }
  function openMenu() {
    menuOpen = true;
    menuIndex = 0;
    if (session) session.suspended = true;
    nav.paused = false;
    renderMenu();
    $("menu").classList.replace("hidden", "grid");
  }
  function closeMenu() {
    menuOpen = false;
    if (session) session.suspended = false;
    nav.paused = true;
    $("menu").classList.replace("grid", "hidden");
  }

  // Splash and menu navigation. Paused while playing, so game keys do not drive menus.
  const nav = listenNav((action) => {
    if (!session) {
      if (action === "accept") void begin();
      if (action === "back") void quit();
      return;
    }
    if (!menuOpen) return;
    if (action === "up") menuIndex = (menuIndex + items.length - 1) % items.length;
    if (action === "down") menuIndex = (menuIndex + 1) % items.length;
    if (action === "accept") return void items[menuIndex].run();
    if (action === "back") return closeMenu();
    renderMenu();
  });
  $("splash").addEventListener("click", () => !session && void begin());

  // Opening the menu while playing: Escape, gamepad Home, or Select+Start together.
  addEventListener("keydown", (e) => {
    if (session && !menuOpen && e.code === "Escape") {
      e.preventDefault();
      openMenu();
    }
  });
  let comboHeld = false;
  const watchPads = () => {
    if (session && !menuOpen) {
      const combo = [...(navigator.getGamepads?.() ?? [])].some(
        (p) => p && (p.buttons[16]?.pressed || (p.buttons[8]?.pressed && p.buttons[9]?.pressed)),
      );
      if (combo && !comboHeld) openMenu();
      comboHeld = combo;
    }
    requestAnimationFrame(watchPads);
  };
  requestAnimationFrame(watchPads);

  setInterval(async () => {
    if (!session || !statsOn) return;
    const rows = await sampler.sample(session);
    $("stats").replaceChildren(
      ...rows.flatMap(({ label, value }) => {
        const dt = document.createElement("dt");
        dt.className = "text-slate-400";
        dt.textContent = label;
        const dd = document.createElement("dd");
        dd.className = "text-right tabular-nums";
        dd.textContent = value;
        return [dt, dd];
      }),
    );
  }, 1000);

  // Leaving the page ends the session promptly rather than waiting for the idle timeout.
  addEventListener("pagehide", () => {
    if (info) navigator.sendBeacon?.(`/api/sessions/${info.id}/stop`);
  });
</script>
