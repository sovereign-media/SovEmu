---
// Home: the system carousel. Left/right picks a system, A opens its games.
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import HintBar from "../components/HintBar.astro";
---

<Base title="Systems">
  <div data-backdrop class="fixed inset-0 transition-[background] duration-500"></div>
  <TopBar />

  <main class="relative grid min-h-dvh grid-rows-[1fr_auto_1fr] overflow-hidden">
    <div></div>
    <section class="grid gap-10">
      <div data-track class="flex items-center gap-8 px-[50vw] transition-transform duration-300 ease-out will-change-transform"></div>
      <div class="text-center">
        <h1 data-name class="text-4xl font-black tracking-tight md:text-5xl"></h1>
        <p data-meta class="mt-2 text-lg text-slate-300"></p>
      </div>
    </section>
    <p data-empty class="hidden self-start text-center text-slate-400">
      No games yet. Add ROMs to the library (one folder per system: <code>nes/</code>, <code>snes/</code>, …) and rescan.
    </p>
  </main>

  <HintBar hints={[{ button: "dpad", label: "Choose" }, { button: "a", label: "Open" }, { button: "start", label: "Rescan" }]} />
</Base>

<script>
  import { api, type SystemSummary } from "../lib/api";
  import { systemBadge } from "../lib/systems";
  import { listenNav } from "../lib/nav";

  const track = document.querySelector<HTMLElement>("[data-track]")!;
  const nameEl = document.querySelector<HTMLElement>("[data-name]")!;
  const metaEl = document.querySelector<HTMLElement>("[data-meta]")!;
  const backdrop = document.querySelector<HTMLElement>("[data-backdrop]")!;
  const STORAGE_KEY = "sovemu.system";

  let systems: SystemSummary[] = [];
  let index = 0;

  function card(s: SystemSummary): HTMLElement {
    const el = document.createElement("button");
    el.className =
      "relative grid h-44 w-72 shrink-0 place-items-center rounded-3xl border border-white/10 text-5xl font-black tracking-tight text-white shadow-2xl transition-all duration-300";
    el.style.background = `linear-gradient(145deg, ${s.color}, color-mix(in srgb, ${s.color} 35%, black))`;
    el.innerHTML = `<span>${s.short}</span>`;
    const status = systemBadge(s);
    if (status) {
      const badge = document.createElement("span");
      badge.className = "absolute bottom-3 right-4 rounded bg-black/60 px-2 py-0.5 text-[11px] font-semibold tracking-normal";
      badge.textContent = status;
      el.append(badge);
    }
    el.addEventListener("click", () => {
      const i = systems.indexOf(s);
      if (i === index) open();
      else select(i);
    });
    return el;
  }

  function select(i: number) {
    if (!systems.length) return;
    index = (i + systems.length) % systems.length;
    const s = systems[index];
    localStorage.setItem(STORAGE_KEY, s.id);
    [...track.children].forEach((el, j) => {
      const focused = j === index;
      el.classList.toggle("scale-110", focused);
      el.classList.toggle("opacity-35", !focused);
      el.classList.toggle("ring-4", focused);
      el.classList.toggle("ring-white/80", focused);
    });
    // Centre the focused card: each card is 18rem wide plus a 2rem gap.
    track.style.transform = `translateX(calc(${-index} * 20rem - 9rem))`;
    nameEl.textContent = s.name;
    const games = `${s.game_count} game${s.game_count === 1 ? "" : "s"}`;
    metaEl.textContent = `${s.manufacturer} · ${s.year} · ${games}`;
    backdrop.style.background = `radial-gradient(ellipse at 50% 40%, color-mix(in srgb, ${s.color} 45%, transparent), #0b0d12 70%)`;
  }

  function open() {
    const s = systems[index];
    if (s) location.href = `/system/?id=${encodeURIComponent(s.id)}`;
  }

  async function load() {
    const all = await api.systems();
    systems = all.filter((s) => s.game_count > 0);
    track.replaceChildren(...systems.map(card));
    document.querySelector("[data-empty]")!.classList.toggle("hidden", systems.length > 0);
    const remembered = systems.findIndex((s) => s.id === localStorage.getItem(STORAGE_KEY));
    select(Math.max(0, remembered));
  }

  await load();
  listenNav(async (action) => {
    if (action === "left") select(index - 1);
    if (action === "right") select(index + 1);
    if (action === "accept") open();
    if (action === "menu") {
      metaEl.textContent = "Rescanning the library…";
      try {
        await api.scan();
      } catch {
        /* only admins can rescan */
      }
      await load();
    }
  });
</script>
