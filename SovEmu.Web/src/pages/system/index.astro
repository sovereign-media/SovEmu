---
// One system's games: a list on the left, the focused game's details on the right.
import Base from "../../layouts/Base.astro";
import TopBar from "../../components/TopBar.astro";
import HintBar from "../../components/HintBar.astro";
---

<Base title="Games">
  <div data-backdrop class="fixed inset-0"></div>
  <TopBar crumb="Games" />

  <main class="relative mx-auto grid h-dvh max-w-7xl grid-cols-1 gap-8 px-8 pb-24 pt-24 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
    <section class="flex min-h-0 flex-col">
      <h1 class="mb-4 flex items-baseline gap-3">
        <span data-badge class="rounded-lg px-2.5 py-1 text-sm font-black"></span>
        <span data-system class="text-2xl font-bold"></span>
        <span data-count class="text-sm text-slate-400"></span>
      </h1>
      <ol data-list class="min-h-0 flex-1 overflow-y-auto scroll-smooth rounded-xl bg-black/30 p-2"></ol>
    </section>

    <aside data-details class="hidden self-center rounded-2xl border border-white/10 bg-panel/70 p-8 shadow-2xl backdrop-blur md:block">
      <div data-art class="mb-6 grid aspect-[4/3] place-items-center rounded-xl text-6xl font-black text-white/90"></div>
      <h2 data-title class="text-3xl font-black leading-tight"></h2>
      <div data-tags class="mt-3 flex flex-wrap gap-2"></div>
      <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        <dt class="text-slate-400">Last played</dt><dd data-played></dd>
        <dt class="text-slate-400">Times played</dt><dd data-plays></dd>
        <dt class="text-slate-400">File</dt><dd data-file class="truncate font-mono text-xs leading-5"></dd>
        <dt class="text-slate-400">Size</dt><dd data-size></dd>
      </dl>
    </aside>
  </main>

  <HintBar hints={[{ button: "dpad", label: "Choose" }, { button: "a", label: "Play" }, { button: "b", label: "Systems" }]} />
</Base>

<script>
  import { api, formatAgo, formatSize, type Game } from "../../lib/api";
  import { listenNav } from "../../lib/nav";

  const params = new URLSearchParams(location.search);
  const systemId = params.get("id") ?? "";
  const $ = <T extends HTMLElement>(name: string) => document.querySelector<T>(`[data-${name}]`)!;
  const list = $<HTMLOListElement>("list");
  const PAGE = 10;

  const [systems, games] = await Promise.all([api.systems(), api.games(systemId)]);
  const system = systems.find((s) => s.id === systemId);
  if (!system) location.replace("/");

  const color = system?.color ?? "#4169e1";
  document.title = `${system?.name ?? "Games"} · SovEmu`;
  $("backdrop").style.background = `radial-gradient(ellipse at 0% 0%, color-mix(in srgb, ${color} 35%, transparent), #0b0d12 60%)`;
  $("badge").textContent = system?.short ?? "";
  $("badge").style.background = color;
  $("system").textContent = system?.name ?? "";
  $("count").textContent = `${games.length} game${games.length === 1 ? "" : "s"}`;
  $("art").style.background = `linear-gradient(145deg, ${color}, color-mix(in srgb, ${color} 30%, black))`;
  $("art").textContent = system?.short ?? "";

  const rememberKey = `sovemu.game.${systemId}`;
  let index = Math.max(0, games.findIndex((g) => String(g.id) === localStorage.getItem(rememberKey)));

  list.replaceChildren(
    ...games.map((g, i) => {
      const li = document.createElement("li");
      li.className = "flex cursor-pointer items-center gap-3 rounded-lg px-4 py-2.5 text-lg transition-colors";
      const title = document.createElement("span");
      title.className = "truncate";
      title.textContent = g.title;
      li.append(title);
      if (g.tags) {
        const tags = document.createElement("span");
        tags.className = "ml-auto shrink-0 text-xs text-slate-400";
        tags.textContent = g.tags;
        li.append(tags);
      }
      li.addEventListener("click", () => (i === index ? play() : select(i)));
      return li;
    }),
  );

  function select(i: number) {
    if (!games.length) return;
    index = Math.min(Math.max(i, 0), games.length - 1);
    const g: Game = games[index];
    localStorage.setItem(rememberKey, String(g.id));
    [...list.children].forEach((el, j) => {
      const on = j === index;
      (el as HTMLElement).style.background = on ? color : "";
      el.classList.toggle("font-semibold", on);
      el.classList.toggle("text-slate-300", !on);
    });
    list.children[index]?.scrollIntoView({ block: "nearest" });
    $("details").classList.remove("hidden");
    $("title").textContent = g.title;
    $("tags").replaceChildren(
      ...g.tags.split(",").map((t) => t.trim()).filter(Boolean).map((t) => {
        const chip = document.createElement("span");
        chip.className = "rounded-full bg-white/10 px-2.5 py-0.5 text-xs";
        chip.textContent = t;
        return chip;
      }),
    );
    $("played").textContent = formatAgo(g.last_played_at);
    $("plays").textContent = String(g.play_count ?? 0);
    $("file").textContent = g.path;
    $("size").textContent = formatSize(g.size);
  }

  function play() {
    const g = games[index];
    if (g) location.href = `/play/?game=${g.id}`;
  }

  select(index);
  listenNav((action) => {
    if (action === "up") select(index - 1);
    if (action === "down") select(index + 1);
    if (action === "pageUp" || action === "left") select(index - PAGE);
    if (action === "pageDown" || action === "right") select(index + PAGE);
    if (action === "accept") play();
    if (action === "back") location.href = "/";
  });
</script>
