---
// Emulator settings: each system's core options (rendering, resolution, frame skip …), which an
// admin can change. Changes apply to the next game started. Options set in the server's
// environment win and are shown locked; the admin's changes can be copied out as environment
// lines, so the configuration stays reproducible without this page.
import Base from "../../../layouts/Base.astro";
import TopBar from "../../../components/TopBar.astro";

const card = "rounded-2xl border border-white/10 bg-panel/80 p-6";
---

<Base title="Settings">
  <TopBar crumb="Settings" />
  <main class="mx-auto grid max-w-4xl gap-6 px-6 pb-16 pt-24">
    <section class={card}>
      <h2 class="text-xl font-bold">Emulator settings</h2>
      <p class="mt-2 text-sm text-slate-400">
        Each system's emulator options: rendering, resolution, frame skipping and more. Changes apply to the next
        game started.
      </p>
      <div data-systems class="mt-4 flex flex-wrap gap-2"></div>
    </section>

    <section data-panel class={`${card} hidden`}>
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div>
          <h2 data-name class="text-xl font-bold"></h2>
          <p data-core class="text-sm text-slate-400"></p>
        </div>
        <input data-filter type="search" placeholder="Filter settings" class="w-64 max-w-full rounded-md border border-edge bg-black/30 px-3 py-1.5 text-sm" />
      </div>
      <p data-message class="mt-4 hidden text-sm"></p>
      <ul data-list class="mt-4 divide-y divide-white/5"></ul>
    </section>

    <section data-env-card class={`${card} hidden`}>
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-bold">As environment variables</h2>
        <button data-copy class="rounded-md border border-edge px-3 py-1.5 text-sm hover:bg-white/10">Copy</button>
      </div>
      <p class="mt-2 text-sm text-slate-400">
        The changes made here, as server settings. Put them in <code>.env</code> or the Helm values to make them part of
        the configuration; settings from the environment always win.
      </p>
      <pre data-env class="mt-3 overflow-x-auto rounded-lg bg-black/40 p-3 text-xs"></pre>
    </section>
  </main>
</Base>

<script>
  import { api, type CoreSetting, type SystemSettings, type SystemSummary } from "../../../lib/api";
  import { choiceLabel, filterSettings, sourceBadge } from "../../../lib/settings";

  const $ = <T extends HTMLElement>(name: string) => document.querySelector<T>(`[data-${name}]`)!;
  const status = await api.status();
  if (!status.user?.is_admin) location.replace("/");

  const systems = (await api.systems()).filter((s) => s.playable || s.needs_gpu);
  let current: SystemSummary | null = null;
  let loaded: SystemSettings | null = null;

  function message(text: string, error = false) {
    const m = $("message");
    m.textContent = text;
    m.classList.toggle("hidden", !text);
    m.classList.toggle("text-red-300", error);
    m.classList.toggle("text-emerald-300", !error);
  }

  function chips() {
    $("systems").replaceChildren(
      ...systems.map((s) => {
        const b = document.createElement("button");
        b.textContent = s.name;
        const on = s.id === current?.id;
        b.className = `rounded-full border px-3 py-1 text-sm ${on ? "border-transparent text-white" : "border-edge text-slate-300 hover:bg-white/10"}`;
        if (on) b.style.background = s.color;
        b.addEventListener("click", () => select(s));
        return b;
      }),
    );
  }

  async function change(key: string, value: string | null) {
    if (!current) return;
    try {
      show(await api.changeSettings(current.id, { [key]: value }));
      message(value === null ? `${key} reset. Applies to the next game started.` : `Saved. Applies to the next game started.`);
    } catch (e) {
      message((e as Error).message, true);
      if (loaded) show(loaded);
    }
  }

  function row(s: CoreSetting): HTMLElement {
    const li = document.createElement("li");
    li.className = "flex flex-wrap items-center justify-between gap-3 py-3";
    const text = document.createElement("div");
    text.className = "min-w-0 flex-1";
    const title = document.createElement("p");
    title.className = "flex flex-wrap items-center gap-2 font-semibold";
    title.textContent = s.description;
    const badge = sourceBadge(s.source);
    if (badge) {
      const b = document.createElement("span");
      b.className = `rounded px-1.5 py-0.5 text-[11px] font-semibold ${s.source === "environment" ? "bg-amber-500/20 text-amber-200" : "bg-white/10 text-slate-300"}`;
      b.textContent = badge.text;
      b.title = badge.title;
      title.append(b);
    }
    const key = document.createElement("p");
    key.className = "truncate font-mono text-xs text-slate-500";
    key.textContent = s.key;
    text.append(title, key);

    const controls = document.createElement("div");
    controls.className = "flex items-center gap-2";
    const locked = s.source === "environment";
    if (s.choices.length) {
      const select = document.createElement("select");
      select.className = "max-w-64 rounded-md border border-edge bg-black/30 px-2 py-1 text-sm disabled:opacity-60";
      select.disabled = locked;
      for (const c of s.choices) select.append(new Option(choiceLabel(c, s.default), c, false, c === s.value));
      if (!s.choices.includes(s.value)) select.append(new Option(s.value, s.value, false, true));
      select.addEventListener("change", () => change(s.key, select.value));
      controls.append(select);
    } else {
      const value = document.createElement("code");
      value.className = "text-sm text-slate-300";
      value.textContent = s.value;
      controls.append(value);
    }
    if (s.source === "admin") {
      const reset = document.createElement("button");
      reset.className = "rounded-md px-2 py-1 text-xs text-slate-400 hover:bg-white/10 hover:text-white";
      reset.textContent = "Reset";
      reset.addEventListener("click", () => change(s.key, null));
      controls.append(reset);
    }
    li.append(text, controls);
    return li;
  }

  function show(s: SystemSettings) {
    loaded = s;
    $("core").textContent = s.core;
    const shown = filterSettings(s.settings, $<HTMLInputElement>("filter").value);
    $("list").replaceChildren(...shown.map(row));
    if (!s.settings.length) message("This emulator has no settings.");
    $("env").textContent = s.environment.join("\n");
    $("env-card").classList.toggle("hidden", !s.environment.length);
  }

  async function select(s: SystemSummary) {
    current = s;
    history.replaceState(null, "", `?id=${encodeURIComponent(s.id)}`);
    chips();
    $("panel").classList.remove("hidden");
    $("name").textContent = s.name;
    $("core").textContent = "Reading the emulator's settings…";
    $("list").replaceChildren();
    message("");
    try {
      show(await api.systemSettings(s.id));
    } catch (e) {
      $("core").textContent = "";
      message((e as Error).message, true);
    }
  }

  $("filter").addEventListener("input", () => loaded && show(loaded));
  $("copy").addEventListener("click", async () => {
    await navigator.clipboard.writeText($("env").textContent ?? "");
    $("copy").textContent = "Copied";
    setTimeout(() => ($("copy").textContent = "Copy"), 1500);
  });

  const wanted = new URLSearchParams(location.search).get("id");
  chips();
  const first = systems.find((s) => s.id === wanted) ?? systems[0];
  if (first) void select(first);
</script>
