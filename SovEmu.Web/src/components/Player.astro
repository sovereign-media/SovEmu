---
// The player: connects to the server over WebRTC, shows the stream and sends input.
const aspects = [
  { value: "4/3", label: "4:3" },
  { value: "3/2", label: "3:2 (GBA)" },
  { value: "10/9", label: "10:9 (Game Boy)" },
  { value: "native", label: "Native pixels" },
];
---

<section class="grid gap-3" data-player>
  <div class="flex flex-wrap items-center gap-2">
    <button data-connect class="rounded-md bg-accent px-3 py-1.5 font-medium hover:brightness-110 disabled:opacity-50">
      Connect
    </button>
    <button data-fullscreen class="rounded-md border border-edge bg-panel px-3 py-1.5 hover:bg-edge">
      Fullscreen
    </button>
    <select data-aspect class="rounded-md border border-edge bg-panel px-2 py-1.5" title="Display aspect">
      {aspects.map((a) => <option value={a.value}>{a.label}</option>)}
    </select>
    <span data-state class="text-sm text-muted">disconnected</span>
  </div>

  <div data-screen class="grid aspect-[4/3] place-items-center overflow-hidden rounded-lg bg-black">
    <video data-video autoplay playsinline class="pixelated h-full w-full object-fill"></video>
  </div>

  <dl data-stats class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-2"></dl>

  <p class="text-xs text-muted">
    Keyboard: arrows = D-pad, <kbd>Z</kbd> B, <kbd>X</kbd> A, <kbd>A</kbd> Y, <kbd>S</kbd> X,
    <kbd>Q</kbd>/<kbd>W</kbd> L/R, <kbd>Enter</kbd> Start, <kbd>Shift</kbd> Select. Gamepads work too
    (standard mapping; the left stick doubles as the D-pad).
  </p>
</section>

<style>
  @reference "../styles/global.css";

  kbd {
    @apply rounded border border-edge bg-panel px-1 text-[11px];
  }
</style>

<script>
  import { InputState } from "../lib/input";
  import { Session } from "../lib/session";
  import { StatsSampler } from "../lib/stats";

  const root = document.querySelector<HTMLElement>("[data-player]")!;
  const $ = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-${name}]`)!;
  const video = $<HTMLVideoElement>("video");
  const screen = $("screen");
  const stateEl = $("state");
  const statsEl = $("stats");
  const connectBtn = $<HTMLButtonElement>("connect");

  const input = new InputState();
  let session: Session | null = null;
  let sampler = new StatsSampler();

  connectBtn.addEventListener("click", async () => {
    session?.close();
    sampler = new StatsSampler();
    connectBtn.disabled = true;
    stateEl.textContent = "connecting…";
    session = new Session(video, input, {
      onState: (state) => {
        stateEl.textContent = state;
        if (state !== "new" && state !== "connecting") connectBtn.disabled = false;
      },
    });
    try {
      await session.connect();
    } catch (e) {
      stateEl.textContent = e instanceof Error ? e.message : String(e);
      connectBtn.disabled = false;
    }
  });

  $("fullscreen").addEventListener("click", () => screen.requestFullscreen?.());

  $<HTMLSelectElement>("aspect").addEventListener("change", (e) => {
    const value = (e.target as HTMLSelectElement).value;
    const native = value === "native";
    screen.style.aspectRatio = native ? "auto" : value.replace("/", " / ");
    video.classList.toggle("object-contain", native);
    video.classList.toggle("object-fill", !native);
  });

  setInterval(async () => {
    if (!session) return;
    const items = await sampler.sample(session);
    statsEl.replaceChildren(
      ...items.map(({ label, value }) => {
        const div = document.createElement("div");
        div.className = "rounded-md bg-panel px-3 py-2";
        const dd = document.createElement("dd");
        dd.className = "text-lg font-semibold tabular-nums";
        dd.textContent = value;
        const dt = document.createElement("dt");
        dt.className = "text-xs text-muted";
        dt.textContent = label;
        div.append(dd, dt);
        return div;
      }),
    );
  }, 1000);
</script>
