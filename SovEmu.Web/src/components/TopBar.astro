---
// The top bar: wordmark, an optional crumb, the signed-in user and a clock.
interface Props {
  crumb?: string;
}
const { crumb } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-10 flex items-center gap-4 bg-gradient-to-b from-black/70 to-transparent px-8 pb-8 pt-5">
  <a href="/" class="text-lg font-black tracking-tight text-white">Sov<span class="text-accent">Emu</span></a>
  {crumb && <span class="text-sm uppercase tracking-[0.2em] text-slate-400" data-crumb>{crumb}</span>}
  <div class="ml-auto flex items-center gap-4">
    <nav data-admin class="hidden gap-1">
      <a href="/admin/" class="rounded-md px-2 py-1 text-xs text-slate-400 hover:bg-white/10 hover:text-white">Library</a>
      <a href="/admin/settings/" class="rounded-md px-2 py-1 text-xs text-slate-400 hover:bg-white/10 hover:text-white">Settings</a>
    </nav>
    <span class="text-sm text-slate-400" data-user></span>
    <button data-logout class="hidden rounded-md px-2 py-1 text-xs text-slate-400 hover:bg-white/10 hover:text-white">Sign out</button>
    <span class="font-mono text-sm tabular-nums text-slate-300" data-clock></span>
  </div>
</header>

<script>
  import { api } from "../lib/api";

  const clock = document.querySelector<HTMLElement>("[data-clock]")!;
  const tick = () => (clock.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));
  tick();
  setInterval(tick, 10_000);

  api.status().then((s) => {
    if (!s.user) return;
    document.querySelector<HTMLElement>("[data-user]")!.textContent = s.user.username;
    if (s.user.is_admin) document.querySelector<HTMLElement>("[data-admin]")!.classList.replace("hidden", "flex");
    const logout = document.querySelector<HTMLButtonElement>("[data-logout]")!;
    logout.classList.remove("hidden");
    logout.addEventListener("click", async () => {
      await api.logout();
      location.href = "/login/";
    });
  });
</script>
