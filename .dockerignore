# The build context is the repository root (see SovEmu.Backend/Dockerfile). Only
# SovEmu.Backend/ and scripts/ feed the image; keep everything heavy or private out.
**/.git
**/.DS_Store
SovEmu.Backend/target
cores
roms
system
data
headless-out
test-results
.claude
.github
docs

# The web client is built inside the image from its sources; never send local build output.
SovEmu.Web/node_modules
SovEmu.Web/dist
SovEmu.Web/.astro

# The native clients never feed the server image.
SovEmu.Android
SovEmu.iOS
.env
