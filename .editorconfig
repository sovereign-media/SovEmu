root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{toml,yml,yaml,json,md,sh}]
indent_style = space
indent_size = 2

[SovEmu.Backend/SovEmu.LibretroFfi/include/libretro.h]
# Vendored verbatim from upstream; never reformat.
trim_trailing_whitespace = false
insert_final_newline = false
