# Copy to .env (gitignored). Every SovEmu setting is an environment variable; compose loads this
# file as a whole. Every value is optional. Secrets may instead be read from a file:
# SOVEMU_ADMIN_PASSWORD_FILE=/run/secrets/admin_password (likewise for the other passwords/keys).

# --- Accounts ---------------------------------------------------------------------------------
# The admin, created at startup (its password follows this value). Without it, the first visit
# asks for one.
SOVEMU_ADMIN_USERNAME=
SOVEMU_ADMIN_PASSWORD=
# More accounts, numbered from 0, kept in step like the admin (__PASSWORD_FILE also works):
# SOVEMU_USERS__0__USERNAME=kid
# SOVEMU_USERS__0__PASSWORD=
# SOVEMU_USERS__0__ROLE=viewer      # or admin
# Delete accounts that are not declared here, at startup.
SOVEMU_USERS_PRUNE=false
# Sign-ins last this many days; usernames lock out after N failures for M minutes (N=0: never),
# and client addresses after N failures across usernames.
SOVEMU_SESSION_DAYS=90
# Apps' access tokens last this many minutes before they refresh them.
SOVEMU_ACCESS_TOKEN_MINUTES=60
# A just-used refresh token is honoured again for this long (two tabs at once); 0: once only.
SOVEMU_REFRESH_RETRY_SECONDS=30
# The addresses people reach the server at, comma-separated: sign-in works only there. Unset:
# localhost, 127.0.0.1 and SOVEMU_ADVERTISE_IP on the HTTP port.
SOVEMU_PUBLIC_URL=
# Whether the apps may sign in with a password, as well as with a code shown on the screen.
SOVEMU_PASSWORD_SIGN_IN=true
# The secret the sign-in token signing key is derived from. Unset: generated once into
# data/server.json. A secret: SOVEMU_TOKEN_KEY_FILE works too.
SOVEMU_TOKEN_KEY=
SOVEMU_LOGIN_MAX_FAILURES=5
SOVEMU_LOGIN_MAX_FAILURES_PER_IP=20
SOVEMU_LOGIN_LOCKOUT_MINUTES=5

# --- Network ----------------------------------------------------------------------------------
# The address browsers send game media to (this host's LAN address).
SOVEMU_ADVERTISE_IP=
# STUN/TURN for clients that cannot reach the UDP ports, as JSON RTCIceServers.
SOVEMU_ICE_SERVERS=
# Set when served over HTTPS (behind a reverse proxy).
SOVEMU_SECURE_COOKIES=
# The reverse proxies whose X-Forwarded-For names the client (comma-separated addresses or
# ranges). Unset: the client is whoever connects.
SOVEMU_TRUSTED_PROXIES=
# The key signing file URLs (artwork, videos, screenshots). Unset: generated once into
# data/server.json. A secret: SOVEMU_ASSET_KEY_FILE works too.
SOVEMU_ASSET_KEY=
# How long a signed file URL stays valid, in hours.
SOVEMU_ASSET_URL_HOURS=24

# --- Streaming --------------------------------------------------------------------------------
SOVEMU_VIDEO_KBPS=2500
SOVEMU_AUDIO_KBPS=128
# Seconds a game session survives with no client connected.
SOVEMU_IDLE_TIMEOUT=300
# Seconds a game may take to load (disc images over a slow share take a while).
SOVEMU_WORKER_START_TIMEOUT=120
# Seconds a game may take to write its saves and exit when it ends, before it is killed.
SOVEMU_WORKER_STOP_TIMEOUT=15
# Rewind history in seconds (0: off) and its memory cap per session in MiB.
SOVEMU_REWIND_SECONDS=60
SOVEMU_REWIND_MAX_MB=64
# Fast-forward speed, and frames between video keyframes.
SOVEMU_FAST_FORWARD=4
SOVEMU_KEYFRAME_INTERVAL=600
SOVEMU_SESSION_HEALTH_SECS=10
# The home screen: games in the hero (0 hides it) and in each row.
SOVEMU_HOME_FEATURED=8
SOVEMU_HOME_ROW=20
# 3D systems (N64, Dreamcast, GameCube, PS2): auto (first working GPU, else software rendering),
# software, off, or a render node such as /dev/dri/renderD128.
SOVEMU_GPU=auto
# UDP ports for sessions (one per concurrent game) and the address they bind to.
SOVEMU_UDP_PORTS=50000-50009
SOVEMU_UDP_BIND=0.0.0.0

# --- Library upkeep ---------------------------------------------------------------------------
# Rescan every N minutes (0: startup only); mirror mode syncs every N minutes.
SOVEMU_SCAN_INTERVAL_MINUTES=60
SOVEMU_MIRROR_INTERVAL_MINUTES=360
# Look up game information for new games after each scan.
SOVEMU_METADATA_AUTO=true
# BIOS files, one folder per system named like its ROM folder (psx/, ps2/, dreamcast/ …),
# checked by name and MD5. Default: <data>/bios (/data/bios in the container). Keep it local.
# SOVEMU_BIOS_DIR=/data/bios

# --- A NAS library (compose.nas.yaml) ---------------------------------------------------------
# The share plus the folder holding roms/ (Batocera layout). BIOS files stay local, in
# data/bios/<system>/ (SOVEMU_BIOS_DIR).
SOVEMU_NAS_HOST=nas.blh.casa
SOVEMU_NAS_PATH=MEDIA/emulation
SOVEMU_NAS_USER=
SOVEMU_NAS_PASSWORD=

# --- A GPU (compose.gpu.yaml) -----------------------------------------------------------------
# The host group owning /dev/dri/renderD128: stat -c %g /dev/dri/renderD128
# SOVEMU_RENDER_GID=
# direct (NAS on the same network, the usual case) | cache (remote NAS) | mirror (local copy)
SOVEMU_LIBRARY_MODE=direct
# cache mode: GiB of played games and artwork to keep locally
SOVEMU_CACHE_GB=20
# mirror mode: only these systems (comma-separated ids, e.g. nes,snes,gba); empty = all
SOVEMU_MIRROR_SYSTEMS=
# cache mode: games over this size (MiB) are cached after their first session, not before.
SOVEMU_CACHE_LARGE_GAME_MB=64
# Files copied at once by the mirror sync and the artwork cache.
SOVEMU_COPY_THREADS=4

# --- Systems ----------------------------------------------------------------------------------
# Per system id (nes, snes, gb, gbc, gba, megadrive, mastersystem, gamegear, psx, fbneo, neogeo):
# SOVEMU_SYSTEMS__psx__OPTIONS__pcsx_rearmed_cd_readahead=512   (a libretro core option)
# SOVEMU_SYSTEMS__nes__CORE=nestopia                            (a core to use instead)
# SOVEMU_SYSTEMS__gamegear__ENABLED=false                       (hide the system)
# SOVEMU_SYSTEMS__snes__RUN_AHEAD=1                              (frames run ahead, 0-4, 2D systems)

# --- Controllers ------------------------------------------------------------------------------
# Default button mappings per controller model (IDs and input names: docs/CONTROLLERS.md), for
# every user without their own. The admin page's Controllers screen offers its defaults in
# this form; these win over it.
# SOVEMU_CONTROLLERS__0__ID=xbox
# SOVEMU_CONTROLLERS__0__NAME=Xbox Controller
# SOVEMU_CONTROLLERS__0__BINDINGS=south:A,east:B,west:Y,north:X,l1:L,r1:R,select:SELECT,start:START

# --- Game information -------------------------------------------------------------------------
# The LaunchBox Games Database: no account; its dump (about 110 MB) is downloaded into
# data/metadata/launchbox/ and checked for a newer one when this many hours old (0: never).
SOVEMU_LAUNCHBOX=true
SOVEMU_LAUNCHBOX_REFRESH_HOURS=168
# ScreenScraper (screenscraper.fr): developer credentials are requested on its forum; a user
# account (free) raises the daily quota.
SOVEMU_SCREENSCRAPER_DEVID=
SOVEMU_SCREENSCRAPER_DEVPASSWORD=
SOVEMU_SCREENSCRAPER_USER=
SOVEMU_SCREENSCRAPER_PASSWORD=
# TheGamesDB (thegamesdb.net): request an API key on its forum.
SOVEMU_THEGAMESDB_KEY=
# Preferences for titles, dates and box art, and for descriptions (most preferred first).
SOVEMU_METADATA_REGIONS=us,wor,eu,ss,uk,jp
SOVEMU_METADATA_LANGUAGES=en,wor
# Pause between ScreenScraper requests (free accounts get one request at a time).
SOVEMU_SCREENSCRAPER_DELAY_MS=1200
# Box art downloaded at once, in the background after a lookup (games with no local thumb).
SOVEMU_ARTWORK_DOWNLOADS=4

# --- Operations -------------------------------------------------------------------------------
# Log lines: text (for a person) or json (one object per line, for a log collector).
SOVEMU_LOG_FORMAT=text
# Log timestamps in your time zone (an IANA name); the image defaults to UTC.
TZ=UTC
# An OpenTelemetry collector's OTLP/HTTP address, e.g. http://otel-collector:4318: traces and
# metrics are exported there. Unset: nothing is exported. The standard OTEL_* variables apply
# too (OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES, OTEL_EXPORTER_OTLP_HEADERS for a token).
SOVEMU_OTEL_ENDPOINT=
# Log filter, e.g. info or sovemu_server=debug.
RUST_LOG=info
# Database upkeep every this many minutes: expired sign-ins deleted, statistics refreshed, the
# write-ahead log checkpointed (0: never).
SOVEMU_MAINTENANCE_INTERVAL_MINUTES=60

# --- Decorations (bezels) ----------------------------------------------------------------------
# The set games are framed with: sovemu (built in), a set from the folders below, or none.
SOVEMU_DECORATION=sovemu
# More decoration folders in Batocera's layout (<set>/systems/<id>.png + .info), comma-separated;
# read before data/decorations and the built-in set. compose.nas.yaml sets /nas/decorations.
SOVEMU_DECORATIONS_DIRS=
