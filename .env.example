# Copy to .env (gitignored). Every SovEmu setting is an environment variable; compose loads this
# file as a whole. Every value is optional. Names are SovEmu__<Area>__<Name> (any letter case);
# a list takes one entry per index (__0, __1, ...). Secrets are plain settings too: put Docker or
# Kubernetes secrets in the environment.

# --- Accounts ---------------------------------------------------------------------------------
# The admin, created at startup (its password follows this value). Without it, the first visit
# asks for one.
SovEmu__Authentication__AdminUsername=
SovEmu__Authentication__AdminPassword=
# More accounts, numbered from 0, kept in step like the admin:
# SovEmu__Users__0__Username=kid
# SovEmu__Users__0__Password=
# SovEmu__Users__0__Role=viewer      # or admin
# Delete accounts that are not declared here, at startup.
SovEmu__Users__Prune=false
# Sign-ins last this many days; usernames lock out after N failures for M minutes (N=0: never),
# and client addresses after N failures across usernames.
SovEmu__Authentication__SessionDays=90
# Apps' access tokens last this many minutes before they refresh them.
SovEmu__Authentication__Tokens__AccessTokenMinutes=60
# A just-used refresh token is honoured again for this long (two tabs at once); 0: once only.
SovEmu__Authentication__Tokens__RefreshRetrySeconds=30
# The addresses people reach the server at, one per index: sign-in works only there. Unset:
# localhost, 127.0.0.1 and SovEmu__Streaming__AdvertiseAddress on the HTTP port.
# SovEmu__Http__PublicUrl__0=https://games.example.com
# Whether the apps may sign in with a password, as well as with a code shown on the screen.
SovEmu__Authentication__PasswordSignIn=true
SovEmu__ClientErrors__Enabled=true
# The secret the sign-in token signing key is derived from. Unset: generated once into
# data/server.json. A secret.
SovEmu__Authentication__TokenSigningKey=
SovEmu__Authentication__Lockout__MaxFailures=5
SovEmu__Authentication__Lockout__MaxFailuresPerAddress=20
SovEmu__Authentication__Lockout__Minutes=5

# --- Network ----------------------------------------------------------------------------------
# The address browsers send game media to (this host's LAN address).
SovEmu__Streaming__AdvertiseAddress=
# Games are offered over IPv6 too: auto (this host's global IPv6 address, when there is one and
# the session ports bind every address), off, or an IPv6 address.
SovEmu__Streaming__AdvertiseAddressV6=auto
# Remote play has no settings: games and clients use Cloudflare's and Google's free STUN servers,
# and the built-in TURN relay is always on. Forward port 3478 (UDP and TCP) for it.
# Set when served over HTTPS (behind a reverse proxy).
SovEmu__Http__SecureCookies=
# The reverse proxies whose X-Forwarded-For names the client: an address or range per index.
# Unset: the client is whoever connects.
# SovEmu__Network__TrustedProxyNetwork__0=10.0.0.0/8
# The key signing file URLs (artwork, videos, screenshots). Unset: generated once into
# data/server.json. A secret.
SovEmu__Assets__SecretKey=
# How long a signed file URL stays valid, in hours.
SovEmu__Assets__UrlHours=24

# --- Streaming --------------------------------------------------------------------------------
# Video bitrate, kbit/s: where a stream starts, and the floor and ceiling it adapts between
# (up while the connection has headroom, down on congestion or while the client's decoder
# falls behind).
SovEmu__Streaming__Video__Kbps=5000
SovEmu__Streaming__Video__MinKbps=300
SovEmu__Streaming__Video__MaxKbps=12000
# auto (for each client, the cheapest codec to encode here and decode there), h264 or vp8.
SovEmu__Streaming__Video__Codec=auto
# H.264 encoder: auto (the GPU's, VA-API or NVENC, else x264), vaapi, nvenc or software.
SovEmu__Streaming__Video__Encoder=auto
# Scale the picture up 1 or 2 times by repeating pixels before encoding (2: no colour lost to
# 4:2:0 chroma, four times the pixels to encode and decode). Unset, it is 2 for NES, SNES,
# Game Boy Color, GBA, Genesis and PC Engine and 1 elsewhere; set, it is every system's, and
# SovEmu__Systems__<id>__Prescale still wins.
# SovEmu__Streaming__Video__Prescale=1
# VP8's screen-content mode: 0 off, 1 on, 2 on with more aggressive rate control.
SovEmu__Streaming__Video__ScreenContent=0
SovEmu__Streaming__Audio__Kbps=128
# Seconds a game session survives with no client connected.
SovEmu__Sessions__IdleTimeoutSeconds=300
# Seconds a game may take to load (disc images over a slow share take a while).
SovEmu__Sessions__StartTimeoutSeconds=120
# Seconds a game may take to write its saves and exit when it ends, before it is killed.
SovEmu__Sessions__StopTimeoutSeconds=15
# Rewind history in seconds (0: off) and its memory cap per session in MiB.
SovEmu__Sessions__Rewind__Seconds=60
SovEmu__Sessions__Rewind__MaxMegabytes=64
# Fast-forward speed, and frames between video keyframes.
SovEmu__Sessions__FastForward=4
SovEmu__Streaming__Video__KeyframeInterval=600
# A client silent this long (ms) and then heard again was cut off: it gets a keyframe at once. 0: never.
SovEmu__Streaming__Video__DropoutKeyframeMilliseconds=700
# How long (ms) a new player's connection is checked before their game starts, so the stream
# starts at a rate it carries; 0 turns it off. LanMilliseconds: the same on the server's network.
SovEmu__Streaming__Probe__Milliseconds=2000
SovEmu__Streaming__Probe__LanMilliseconds=750
# Testing only: drop this share (percent) of every game's video packets, to see a stream recover.
SovEmu__Streaming__Debug__VideoDropPercent=0
# Testing only: hold every game's video packets this many milliseconds, as a distant link would.
SovEmu__Streaming__Debug__VideoDelayMilliseconds=0
# Testing only: cut every game's link both ways for this many milliseconds every 10 seconds.
SovEmu__Streaming__Debug__VideoDropBurstMilliseconds=0
# Testing only: every game's link carries at most this much video (kbit/s), as a slow connection.
SovEmu__Streaming__Debug__VideoLimitKbps=0
# Testing only: a folder of frame_NNNNNN.png every game shows instead of its own picture.
#SovEmu__Streaming__Debug__ReplayFrames=
# Testing only: vary each video packet's delay by up to this many milliseconds, as Wi-Fi does.
SovEmu__Streaming__Debug__VideoJitterMilliseconds=0
SovEmu__Sessions__HealthSeconds=10
# Failed games the admin Sessions page keeps, with the core's last log lines (0: none).
SovEmu__Sessions__FailuresKept=50
# The home screen: games in the hero (0 hides it) and in each row.
SovEmu__Home__FeaturedCount=8
SovEmu__Home__RowLength=20
# 3D systems (N64, Dreamcast, GameCube, PS2): auto (first working GPU, else software rendering),
# software, off, or a render node such as /dev/dri/renderD128.
SovEmu__Rendering__Gpu=auto
# UDP ports for sessions (one per concurrent game) and the address they bind to.
SovEmu__Streaming__Udp__Ports=50000-50009
SovEmu__Streaming__Udp__Bind=0.0.0.0
# DSCP mark on every game's packets (0-63): 34 asks Wi-Fi for its video queue, 0 marks nothing.
SovEmu__Streaming__Udp__Dscp=34

# --- Library upkeep ---------------------------------------------------------------------------
# Rescan every N minutes (0: startup only); mirror mode syncs every N minutes.
SovEmu__Library__ScanIntervalMinutes=60
SovEmu__Library__Mirror__IntervalMinutes=360
# Look up game information for new games after each scan.
SovEmu__Metadata__AutoLookup=true
# BIOS files, in any layout: found by MD5 under any name, or by name in any case. A folder per
# system named like its ROM folder (psx/, ps2/, dreamcast/ …) is recommended, not needed. A
# read-only share's bios/ folder works as it is. Default: <data>/bios (/sov-data/bios in the
# container).
# SovEmu__Paths__Bios=/sov-data/bios

# --- A NAS library (compose.nas.yaml) ---------------------------------------------------------
# The share plus the Batocera-style folder holding roms/ and bios/: roms/ is mounted read-only at
# /sov-library and bios/ at /sov-bios (used as it is), nothing else of the share.
SOVEMU_NAS_HOST=nas.example.lan
SOVEMU_NAS_PATH=media/emulation
SOVEMU_NAS_USER=
SOVEMU_NAS_PASSWORD=

# --- A GPU (compose.gpu.yaml) -----------------------------------------------------------------
# The host group owning /dev/dri/renderD128: stat -c %g /dev/dri/renderD128
# SOVEMU_RENDER_GID=
# direct (NAS on the same network, the usual case) | cache (remote NAS) | mirror (local copy)
SovEmu__Library__Mode=direct
# cache mode: GiB of played games and artwork to keep locally
SovEmu__Library__Cache__MaxGigabytes=20
# mirror mode: only these systems, by id, one per index; none = all
# SovEmu__Library__Mirror__Systems__0=nes
# SovEmu__Library__Mirror__Systems__1=snes
# cache mode: games over this size (MiB) are cached after their first session, not before.
SovEmu__Library__Cache__LargeGameMegabytes=64
# Files copied at once by the mirror sync.
SovEmu__Library__CopyThreads=4

# --- Systems ----------------------------------------------------------------------------------
# Per system id (nes, snes, gb, gbc, gba, virtualboy, megadrive, mastersystem, gamegear, sg1000,
# segacd, sega32x, pcengine, pcenginecd, atari2600, atari7800, lynx, ngp, ngpc, wswan, wswanc,
# intellivision, colecovision, vectrex, psx, fbneo, neogeo, n64, dreamcast, gamecube, ps2):
# SovEmu__Systems__psx__Options__pcsx_rearmed_cd_readahead=512   (a libretro core option)
# SovEmu__Systems__nes__Core=nestopia                            (a core to use instead)
# SovEmu__Systems__gamegear__Enabled=false                       (hide the system)
# SovEmu__Systems__snes__RunAhead=2                              (frames run ahead, 0-4, 2D systems; default 1, 0 off)
# SovEmu__Systems__gb__Prescale=2                                (1 or 2; default 2 for nes, snes, gbc, gba, megadrive, pcengine)

# --- Controllers ------------------------------------------------------------------------------
# Default button mappings per controller model (IDs and input names: docs/CONTROLLERS.md), for
# every user without their own. The admin page's Controllers screen offers its defaults in
# this form; these win over it.
# SovEmu__Controllers__0__Id=xbox
# SovEmu__Controllers__0__Name=Xbox Controller
# SovEmu__Controllers__0__Bindings=south:A,east:B,west:Y,north:X,l1:L,r1:R,select:SELECT,start:START

# --- Shared collections -----------------------------------------------------------------------
# Collections everyone sees beside their own, each game as <system id>/<file name>, in order.
# Kept in step after each scan and locked on the admin page (Library: Shared collections),
# which offers the ones made there in this form.
# SovEmu__Collections__0__Name=Family night
# SovEmu__Collections__0__Games__0=nes/Super Stand-in (USA).nes
# SovEmu__Collections__0__Games__1=snes/Another Stand-in (Europe).sfc

# --- Game information -------------------------------------------------------------------------
# The sources, in the order they are asked: FinalBurn Neo's DATs (arcade names) and ScreenScraper.
SovEmu__Metadata__Sources__0=fbneo
SovEmu__Metadata__Sources__1=screenscraper
# Look games up again once their information is this many days old (0: never).
SovEmu__Metadata__RefreshDays=0
# ScreenScraper (screenscraper.fr): the released image carries SovEmu's own developer credentials,
# so leave DevId and DevPassword empty (set them only to use your own, or in a build of your own).
# A user account (free) is steadier than a guest's and raises the daily quota.
SovEmu__Metadata__ScreenScraper__DevId=
SovEmu__Metadata__ScreenScraper__DevPassword=
SovEmu__Metadata__ScreenScraper__Username=
SovEmu__Metadata__ScreenScraper__Password=
# Preferences for titles, dates and box art, and for descriptions, most preferred first. Unset:
# us, wor, eu, ss, uk, jp and en, wor.
# SovEmu__Metadata__Regions__0=us
# SovEmu__Metadata__Regions__1=wor
# SovEmu__Metadata__Languages__0=en
# Pause between ScreenScraper requests, when the account does not give its per-minute limit.
SovEmu__Metadata__ScreenScraper__DelayMilliseconds=1200
# At most this many ScreenScraper requests at once (0: as many as the account allows).
SovEmu__Metadata__ScreenScraper__Threads=0
# Box art and videos downloaded at once, in the background after a lookup (games with no thumb
# or video of their own), never more than the ScreenScraper account allows.
SovEmu__Artwork__MaxConcurrentDownloads=4
# Box art is asked for, and kept, at most this many pixels wide and high (0: full size, as scanned).
SovEmu__Artwork__MaxPixels=1000
# Quality (1-100) of the lossy WebP box art is kept in, and artwork copies at each client's width.
SovEmu__Artwork__WebpQuality=80
# Download gameplay videos for games with none of their own.
SovEmu__Metadata__Videos=true

# --- Operations -------------------------------------------------------------------------------
# Log lines: text (for a person) or json (one object per line, for a log collector).
SovEmu__Logging__Format=text
# Log timestamps in your time zone (an IANA name); the image defaults to UTC.
TZ=UTC
# An OpenTelemetry collector's OTLP/HTTP address, e.g. http://otel-collector:4318: traces and
# metrics are exported there. Unset: nothing is exported. The standard OTEL_* variables apply
# too (OTEL_SERVICE_NAME, OTEL_RESOURCE_ATTRIBUTES, OTEL_EXPORTER_OTLP_HEADERS for a token).
SovEmu__Telemetry__Otlp__Endpoint=
# Log filter, e.g. info or sovemu_server=debug.
RUST_LOG=info
# Database upkeep every this many minutes: expired sign-ins deleted, statistics refreshed, the
# write-ahead log checkpointed (0: never).
SovEmu__Jobs__MaintenanceIntervalMinutes=60
# Backups: the database, the signing keys and every save, one zip file each (the admin's
# Backups page lists them and makes one now). They hold password hashes and keys.
# SovEmu__Backups__Directory=/backups                                    (default <data>/backups)
SovEmu__Backups__IntervalHours=0
SovEmu__Backups__Keep=7
# Restore one at startup (what it replaces is kept in <data>/before-restore-<time>/):
# SovEmu__Backups__RestoreFrom=/backups/sovemu-backup-20261122-163005.zip
# Days of background-job history kept (0: for ever).
SovEmu__Jobs__RetentionDays=30
# Lines of the server's log kept in memory for the admin Logs page (0: none, the view off).
SovEmu__Logging__BufferLines=2000
# Days of the activity log (sign-ins, games played, admin changes) kept (0: for ever).
SovEmu__ActivityLog__RetentionDays=90
# Days of client errors (what the apps reported) kept for the admin Client errors page (0: for ever).
SovEmu__ClientErrors__RetentionDays=30
# Seconds between readings of the container's CPU and memory, for the admin Resources page
# (0: not read), and days of their history kept (0: for ever).
SovEmu__SystemResources__SampleSeconds=5
SovEmu__SystemResources__RetentionDays=30

# --- Decorations (bezels) ----------------------------------------------------------------------
# The set games are framed with: sovemu (built in), a set from the folders below, or none.
SovEmu__Decorations__Set=sovemu
# More decoration folders in Batocera's layout (<set>/systems/<id>.png + .info), one per index;
# read before data/artwork/decorations and the built-in set (compose.nas.yaml says how to mount
# one from the share).
# SovEmu__Decorations__Directories__0=/sov-decorations
# The background behind every screen, for everyone: dither, lattice, screens, a file's name from
# the background folders, random (a different one each visit) or none. Unset: the admin's choice
# on the Appearance page. Set, it locks that page.
SovEmu__Appearance__Background=
# More background folders (WebP, PNG, JPEG, offered by file name), one per index; read before
# data/artwork/backgrounds. System photos of your own: data/artwork/systems/<system id>.webp.
# SovEmu__Appearance__BackgroundDirectories__0=/backgrounds
